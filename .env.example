# ---- App ----
APP_ENV=development
PORT=8080
# Conexión a PostgreSQL (en docker-compose el host es "db")
DATABASE_URL=postgresql://cbtic:cbtic@localhost:5432/cbtic_db?sslmode=disable
# Origen permitido para CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# ---- Noticias / Instagram ----
INSTAGRAM_TARGET_USERNAME=
NEWS_RECENT_DAYS=90
NEWS_SYNC_INTERVAL_MINUTES=60
NEWS_SYNC_ON_STARTUP=true
NEWS_FEATURED_LIMIT=3
NEWS_SYNC_SECRET=

# ---- Clasificador IA (opcional) ----
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# ---- Correo (envío de resultados de exámenes) ----
# Para Gmail: activa la verificación en 2 pasos y crea una "Contraseña de
# aplicación" (16 caracteres, sin espacios). Usa el puerto 587 (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu_app_password_de_16_chars
SMTP_FROM=tucorreo@gmail.com
# A dónde llega cada examen presentado (correo del docente)
EXAM_TEACHER_EMAIL=docente@unimeta.edu.co
